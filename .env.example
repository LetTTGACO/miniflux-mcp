# Required: base URL for your Miniflux instance.
MINIFLUX_URL=https://miniflux.example.com

# Preferred authentication: API key.
MINIFLUX_API_KEY=

# Alternative authentication: username and password.
# Leave MINIFLUX_API_KEY empty if using these.
# MINIFLUX_USERNAME=replace-with-your-username
# MINIFLUX_PASSWORD=replace-with-your-password
